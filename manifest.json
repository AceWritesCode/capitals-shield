{
  "manifest_version": 3,
  "name": "Capital's Shield by Ace",
  "version": "1.2",
  "description": "Trading risk management side panel.",
  "permissions": ["sidePanel", "storage"],
  "action": {
    "default_title": "Open Capital's Shield"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}